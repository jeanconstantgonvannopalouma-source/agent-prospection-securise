    const meta='engine='+(d.engine||'?')+' · tools='+((d.tools_used||[]).map(t=>t.tool).join(',')||'none')+(d.dry_run?' · DRY_RUN':' · LIVE');
    addMsg('agent', d.reply||d.error||'Erreur', meta);
    loadStats(); loadHealth(); loadActivities();
  }catch(err){addMsg('agent','Erreur de connexion');}
  finally{btn.disabled=false;btn.textContent='Envoyer';input.focus();}
}
