    global DRY_RUN
    if request.method == "GET":
        return jsonify({"dry_run": DRY_RUN, "mode": "DRY_RUN" if DRY_RUN else "LIVE"}), 200
    data = request.get_json() or {}
    if "dry_run" in data:
