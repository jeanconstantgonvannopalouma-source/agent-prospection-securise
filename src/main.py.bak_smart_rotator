            e.stopPropagation();
            const input = document.getElementById('prompt');
            const msg = (input && input.value ? input.value : '').trim();
            if (!msg) return;
            if (input) input.value = '';
            sendMsg(msg);
          });
        } else {
          console.error('chat-form introuvable');
        }

