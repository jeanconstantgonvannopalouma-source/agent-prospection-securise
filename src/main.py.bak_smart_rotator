                if (typeof loadHealth === 'function') loadHealth();
                if (typeof loadActivities === 'function') loadActivities();
                if (typeof loadProspects === 'function') loadProspects();
            } catch (e) {
                console.error(e);
                addMsg('agent', 'Erreur de connexion: ' + (e && e.message ? e.message : e));
            } finally {
                if (sendBtn) { sendBtn.disabled = false; sendBtn.textContent = 'Envoyer'; }
                if (input) input.focus();
            }
        } catch(e) { addMsg('agent', 'Erreur de connexion'); }
        }

