            alert(d.message || 'Mémorisé !');
        }
    
        loadMemoryUI();
        addMsg('agent', 'Bonjour Jean Constant ! Ton Dashboard Prospection avec Mémoire Long Terme est actif. est actif. Navigue entre le Chat, tes Prospects et tes Séquences.');
        loadStats(); loadHealth(); loadActivities(); loadProspects();
